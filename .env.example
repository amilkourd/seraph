# Copy to .env and fill. Never commit .env. Every service reads this file from the repo root.

# ── Mode ──
MOCK=0                        # 1 = fixtures only, no external calls

# ── Demo ──
DEMO_ADDRESS=                 # the hackathon venue's address (from the Luma page)
DEMO_TOWN=Paris 9e
BUILDING_JSON=ifc/out/building.json   # Seraph falls back to contracts/fixtures/building.json if missing
PLAN_IMAGE_PATH=contracts/fixtures/plan-level3.svg   # replace with the photo of the venue's door plan
ARI_TIME_FACTOR=10            # compresses ARI time for the demo

# ── LiveKit (voice) ──
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Telephony (Gabriel calls) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # the incident's "112" number, E.164
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_INBOUND_TRUNK_ID=

# ── Gladia (all listening) ──
GLADIA_API_KEY=

# ── TTS (must speak fr, en, es) ──
TTS_PROVIDER=openai           # openai | cartesia | elevenlabs
TTS_API_KEY=

# ── LLM for language tasks (OpenAI-compatible) ──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── H (computer use) ──
H_API_KEY=
H_API_BASE_URL=https://api.hcompany.ai/v1/
HOLO_MODEL=                   # check H's docs for the current Holo model id
ROSETTA_MAX_PARALLEL=4

# ── Devin (Silex) ──
DEVIN_API_KEY=
GITHUB_REPO=<owner>/seraph    # Devin needs access to this repo

# ── Replicas ──
REPLICA_PASSWORD=

# ── Local URLs ──
SERAPH_URL=http://localhost:8000
SERAPH_WS_URL=ws://localhost:8000
ROSETTA_URL=http://localhost:8001
SILEX_URL=http://localhost:8002
TALKIE_URL=http://localhost:3000
HALO_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3002
DISPATCH_URL=http://localhost:8101
REPORT_URL=http://localhost:8102
OCCUPANTS_URL=http://localhost:8103

# ── Public URLs (phones and Devin reach these; tunnel or Vercel) ──
TALKIE_PUBLIC_URL=
HALO_PUBLIC_URL=
SILEX_PUBLIC_URL=
SERAPH_PUBLIC_URL=            # Halo on the phone reads Seraph's SSE through this
OCCUPANTS_PUBLIC_URL=         # only /inscription is used publicly

# ── Building registry (registry/, owned by the ifc session) ──
REGISTRY_BACKEND=            # local (default, offline) | supabase | fire_service
REGISTRY_DIR=                # local backend folder (default registry/data)
REGISTRY_CACHE_DIR=          # where remote backends download models (default registry/.cache)
REGISTRY_ONLINE=             # 1 = BAN/RNB lookup for unknown spellings (default 1; MOCK=1 forces offline)
REGISTRY_BUCKET=             # Supabase Storage bucket (default building-models)
SUPABASE_URL=                # https://<ref>.supabase.co — server-side only
SUPABASE_SECRET_KEY=         # sb_secret_… (or legacy SUPABASE_SERVICE_ROLE_KEY) — server-side only, never in a client
FIRE_SERVICE_REGISTRY_URL=   # fire_service backend: the SDIS registry API
FIRE_SERVICE_REGISTRY_TOKEN= # its bearer token — server-side only
